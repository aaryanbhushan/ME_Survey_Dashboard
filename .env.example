# Copy this file to .env and fill in the blanks. This is the ONLY file you
# need to touch — nothing else in the project is environment-specific.
#
#     copy .env.example .env      (Windows)
#     cp   .env.example .env      (macOS / Linux)

# Port to serve the dashboard on.
PORT=5016

# Absolute path to the dbt executable. LEAVE BLANK in almost all cases.
# `pip install -r requirements.txt` installs dbt next to the Python running
# this app, and run_dbt.py finds it there even when it is not on PATH (which
# it usually is not on Windows). Only fill this in if the Refresh button
# reports "dbt not found" — get the path with:  where dbt   (or: which dbt)
DBT_EXE=

# ── SSH tunnel to reach the PostgreSQL host ───────────────────────────────
# The database is not directly reachable; every connection is forwarded over
# SSH. The app manages the tunnel itself — you do not need to open one.
#
# PG_SSH_PASSWORD rotates often on this estate. A rotation is indistinguishable
# from a lockout: paramiko reports "Authentication failed" either way, so
# re-enter the password here before investigating anything else.
PG_SSH_HOST=
PG_SSH_PORT=22
PG_SSH_USER=
PG_SSH_PASSWORD=

# ── PostgreSQL, as seen FROM the SSH host ─────────────────────────────────
# These are the address the *bastion* uses to reach Postgres, not your machine.
# Leave PG_REMOTE_HOST as 127.0.0.1 unless told otherwise.
# PG_REMOTE_PORT: 5432 and 6432 are both known to work on this estate
# (6432 is PgBouncer in front of the same instance).
PG_REMOTE_HOST=127.0.0.1
PG_REMOTE_PORT=6432
PG_DATABASE=swiggy
PG_USER=appuser
PG_PASSWORD=
